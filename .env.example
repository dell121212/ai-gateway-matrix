# ════════════════════════════════════════════════════════════════
#  AI Gateway Matrix — 环境变量模板 (v2)
#  把这个文件复制为 .env，填入你自己的真实 key，不要把 .env 提交到 git
#  cp .env.example .env
# ════════════════════════════════════════════════════════════════

# ────────────────────────────────────────────────────────────────
#  免费渠道 API Keys
# ────────────────────────────────────────────────────────────────

# 智谱 GLM-4.7-Flash（开放平台官网申请，免费）
# 申请地址: https://open.bigmodel.cn/
GLM_API_KEY=

# Agnes AI（背景公司 Sapiens AI，2026年6月上线，自称永久免费/无总量上限，
# 仅 20 RPM 限速）—— 上线不到一个月，"Claw-Eval"排行榜是其自建/关联评测站，
# 不是独立第三方评测，请知情后使用，建议优先用于非敏感的中等复杂度任务。
# 申请地址: https://platform.agnes-ai.com/settings/apiKeys
AGNES_API_KEY=

# Mistral Vibe 账号 1、2（各自账号的 API Key）
# ⚠️ 用两个账号叠加免费额度这件事，大概率违反 Mistral 的服务条款（多数厂商
# 都禁止"创建多个账号规避速率限制"），个人白嫖习惯请勿直接搬进有真实负载、
# 有真实业务影响的项目里。
# 申请地址: https://console.mistral.ai/
MISTRAL_KEY_1=
MISTRAL_KEY_2=

# （历史遗留：RELAY_STATION_KEY 是 v1 时期泛用的中转站占位变量，v4 起已经
# 换成 AIHUBMIX_API_KEY / VERCEL_AI_API_KEY / GLAMA_API_KEY / AIMLAPI_API_KEY
# 这些具名渠道，config.yaml 里已经不再引用 RELAY_STATION_KEY 了，留空即可）
RELAY_STATION_KEY=

# ────────────────────────────────────────────────────────────────
#  v2 新增：更多免费渠道（详见免费API排名文档）
# ────────────────────────────────────────────────────────────────

# Google Gemini（免费层）
# 申请地址: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq（免费层，超快推理）
# 申请地址: https://console.groq.com/keys
GROQ_API_KEY=

# Cerebras（免费层，超快推理）
# 申请地址: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=

# SambaNova（免费层，唯一能白嫖到 405B 的渠道）
# 申请地址: https://cloud.sambanova.ai/
SAMBANOVA_API_KEY=

# HuggingFace Inference（免费层，社区托管模型）
# 申请地址: https://huggingface.co/settings/tokens
HF_TOKEN=

# SiliconFlow 硅基流动（国内免费层）
# 申请地址: https://cloud.siliconflow.cn/
SILICONFLOW_API_KEY=

# DeepSeek（免费试用额度）
# 申请地址: https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# Together AI（免费试用额度）
# 申请地址: https://api.together.xyz/
TOGETHER_API_KEY=

# OpenRouter（免费模型层）
# 申请地址: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# GitHub Models（免费原型配额，建议使用仅需 models:read 的 fine-grained token）
# 申请地址: https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=

# ────────────────────────────────────────────────────────────────
#  v4 新增：更多官方免费层
# ────────────────────────────────────────────────────────────────

# NVIDIA NIM（免费层，build.nvidia.com）
# 申请地址: https://build.nvidia.com/
NVIDIA_API_KEY=

# DeepInfra（免费层）
# 申请地址: https://deepinfra.com/
DEEPINFRA_API_KEY=

# Novita AI（免费试用）
# 申请地址: https://novita.ai/
NOVITA_API_KEY=

# Fireworks AI（试用额度）
# 申请地址: https://fireworks.ai/
FIREWORKS_API_KEY=

# Lepton AI（试用额度）
# 申请地址: https://www.lepton.ai/
LEPTON_API_KEY=

# ────────────────────────────────────────────────────────────────
#  v4 新增：国内官方免费层
# ────────────────────────────────────────────────────────────────

# 阿里云百炼 DashScope（通义千问，免费 100万 tokens/月）
# 申请地址: https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=

# 腾讯混元（免费 100万 tokens）
# 申请地址: https://cloud.tencent.com/product/hunyuan
HUNYUAN_API_KEY=

# 百度千帆（ERNIE Speed 免费）
# 申请地址: https://qianfan.baidubce.com/
QIANFAN_API_KEY=

# 月之暗面 Kimi（免费试用额度）
# 申请地址: https://platform.moonshot.cn/
MOONSHOT_API_KEY=

# ────────────────────────────────────────────────────────────────
#  v4 新增：聚合/中转站（兜底渠道）
# ────────────────────────────────────────────────────────────────

# AIHubMix（27+ 免费模型聚合）
# 申请地址: https://aihubmix.com/
AIHUBMIX_API_KEY=

# Vercel AI Gateway（$5/月免费额度）
# 申请地址: https://vercel.com/ai-gateway
VERCEL_AI_API_KEY=

# Glama（多供应商聚合，免费层）
# 申请地址: https://glama.ai/
GLAMA_API_KEY=

# AI/ML API（多模型聚合，免费试用）
# 申请地址: https://aimlapi.com/
AIMLAPI_API_KEY=

# ────────────────────────────────────────────────────────────────
#  网关自身配置
# ────────────────────────────────────────────────────────────────

# 网关自己的鉴权 key（自己随便编一个强随机字符串，Vibe CLI 调用网关时要用这个，
# 不是任何上游供应商的 key，纯粹是你自己网关的"门禁密码"）
#
# 重要：留空，别用模板里写死的默认值！
# 这份 .env.example 是公开发布的文件，任何人都能看到这里写了什么默认值——
# 如果你 cp 完没改就直接用，等于给自己的网关设置了一个全网公开已知的弱密码。
# 用下面这条命令生成一个随机的：
#   python3 -c "import secrets; print('sk-' + secrets.token_hex(24))"
GATEWAY_MASTER_KEY=

# 仪表盘管理令牌（不要与 GATEWAY_MASTER_KEY 共用）。
# ./run.sh 会自动生成；手动启动时请自行填写强随机值。
DASHBOARD_TOKEN=

# 内部 Redis/PostgreSQL 密码，./run.sh 会自动生成。
REDIS_PASSWORD=
POSTGRES_PASSWORD=

# 可选：为路由分类器配置独立 Groq Key。留空时禁用外部分类器，
# 路由安全回退到本地启发式规则，避免隐形消耗业务 Key 的额度。
CLASSIFIER_API_KEY=

# 可选：已删除/长期停用渠道的累计统计保留天数；默认 400 天。
# USAGE_TOTAL_RETENTION_DAYS=400
# 仪表盘“今天”使用的自然日时区。
# USAGE_TIMEZONE=Asia/Shanghai

# ────────────────────────────────────────────────────────────────
#  以下变量由 docker-compose.yml 自动设置，不需要在 .env 里手动填
#  （这里列出只是为了文档完整性）
# ────────────────────────────────────────────────────────────────
# REDIS_HOST=redis
# REDIS_PORT=6379
# DATABASE_URL=postgresql://litellm:litellm@postgres:5432/litellm
# PYTHONPATH=/app
# LITELLM_LOG=INFO
